# Copy this file to .env.local (gitignored) and fill in real values from your
# Supabase project's Settings -> API page. Missing/unset values are fine --
# src/lib/supabase.ts falls back to a null client and the app runs exactly as
# it does today, fully local, with login/sync silently disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only -- read by api/grade.ts (a Vercel Serverless Function), never by
# the client. Set these in the Vercel dashboard (Project -> Settings ->
# Environment Variables) and/or your local .env.local for `vercel dev`.
# Deliberately NOT VITE_-prefixed: a VITE_ var gets inlined into the client
# bundle, which would leak the Gemini key. Missing/unset values just make
# api/grade.ts return a 500 and the client silently falls back to manual
# self-check -- nothing breaks.
#
# GEMINI_API_KEY=          # from aistudio.google.com -> "Get API key" (free tier, no card needed)
# AI_GRADING_USER_IDS=     # comma-separated Supabase auth.users UUIDs allowed to use AI grading
